# Copy to `.env.local` and fill in. NEVER commit `.env.local` (it is gitignored).
# In Vercel, set every one of these in Project → Settings → Environment Variables —
# `.env.local` is local-only and does NOT deploy. NEXT_PUBLIC_* values are baked in
# at BUILD time, so they must exist in Vercel before the production build runs.

# ── NGF portal binding ───────────────────────────────────────────────────────
# The client's live domain, no trailing slash. MUST match this client's
# `site_url` in the NGF admin EXACTLY, or the site renders only fallbacks and
# orders can't resolve to the client. Also tags reported orders.
NEXT_PUBLIC_SITE_URL=https://noma-jewelry.com
# Optional — defaults to https://app.ngfsystems.com
NGF_APP_URL=https://app.ngfsystems.com

# Secret shared with the NGF app so it accepts this site's order reports.
# Server-only (no NEXT_PUBLIC_). Without it, orders won't appear in the portal.
NGF_ORDERS_SECRET=

# Secret the NGF portal sends when it pings /api/revalidate after a publish, so
# content edits go live immediately instead of on the 60s ISR timer. Must match
# the value configured in the NGF app.
WEBSITE_REVALIDATION_SECRET=

# ── Square checkout (app/api/checkout/route.ts + CheckoutClient) ──────────────
# Create an app at https://developer.squareup.com/apps. Use the SANDBOX values to
# test, then swap to production. Without the server vars the checkout route fails
# at request time (not at build) — a deploy looks healthy and the first real
# customer sees the error.

# Secret (server-only — never NEXT_PUBLIC_, never commit)
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox          # sandbox | production

# Public (safe in the browser — used to init the Web Payments SDK). The location
# id is the same value as SQUARE_LOCATION_ID; the environment must match too.
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox   # sandbox | production

# ── Optional ─────────────────────────────────────────────────────────────────
# Set to 1 only if cookie-based analytics are added (drives the cookie banner).
# NEXT_PUBLIC_COOKIE_ANALYTICS=1
